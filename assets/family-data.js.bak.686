 W.", "given": "Craig", "surname": "W.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F174@"], "fams": [], "living": true}, "@I379@": {"id": "@I379@", "name": "Kenneth B.", "given": "Kenneth", "surname": "B.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F115@"], "fams": [], "living": true}, "@I699@": {"id": "@I699@", "name": "Amy B.", "given": "Amy", "surname": "B.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F115@"], "fams": ["@F178@", "@F179@"], "living": true}, "@I381@": {"id": "@I381@", "name": "Myrtle Beatrice Hunt", "given": "Myrtle Beatrice", "surname": "Hunt", "sex": "F", "birth": {"date": "Jun 16 1924", "place": ""}, "death": {"date": "Feb 25 2010", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": ["Myrtle is a member of the Order of the Eastern Star and served in the U.S. Navyas an x-ray technician  and nurse from 1963 to 1986. She enlisted as an instructor and taught x-ray and nursing courses. She  retired as a Petty Officer, 1st Class. For most of her military career, her home bases were Pearl Harbor,  Hawaiiand Naples, Italy. She was the first black woman to retire from the Dallas NavalAir Station  and received a plaque from then President, Ronald Reagan.  Settieattended Myrtle’s retirement ceremony as did every one of Myrtle’s past Commanders except  one from Oklahoma, who visited her after she retired."], "famc": ["@F6@"], "fams": []}, "@I384@": {"id": "@I384@", "name": "Valeree Murphy", "given": "Valeree", "surname": "Murphy", "sex": "F", "birth": {"date": "Oct 19 1923", "place": "Tyler, Texas"}, "death":