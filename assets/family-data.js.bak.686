": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F148@"], "fams": [], "living": true}, "@I470@": {"id": "@I470@", "name": "Kayla B.", "given": "Kayla", "surname": "B.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F148@"], "fams": [], "living": true}, "@I428@": {"id": "@I428@", "name": "Hurbert M.", "given": "Hurbert", "surname": "M.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F77@"], "fams": [], "living": true}, "@I130@": {"id": "@I130@", "name": "Angie `Baby` Ree Wallace", "given": "Angie `Baby` Ree", "surname": "Wallace", "sex": "F", "birth": {"date": "Apr 06 1905", "place": "Jefferson, Texas"}, "death": {"date": "Dec 04 1980", "place": "Fort Worth, Texas"}, "burial": {"date": "Dec 09 1980", "place": ""}, "occupation": [], "education": [], "notes": ["Mrs. Angie Wallace (Baby) Battles, born April 6, the youngest of 12 children toMr. and Mrs. Lewis  Wallace Sr. in Marion County, Jefferson, Texas, succumbed toa lengthy illness, Thursday, December 4,  1980 at a local convalescent center.She became a resident of Fort Worth at an early age. She met the late Superintendent Gus Battles and they  were married on July 25, 1922. To this union five children were born. Two of the children and a fosterdaughter  yet live.  Mother Battles became a Christian at an early age and she began her church work then. Shewas saved at  the age of 16 and received the Baptism of the Holy Ghost. She worked in the church faithfully, serving as  church secretary, Sunshine Band president, Home and Foreign Mission president, Usher Board President,  and Mother`s Board president. Her only church home was \"White Street\" Church of God In Christ,later  named \"East Rosedale\" COGIC, and still later \"Love Chapel\" COGIC. Her pastors were: the late Elder E.  E. Hamilton, and Elder S. D. Lee. When her husband, the late Superintendent G. Battles began pastoring  Love Sanctuary, she beganher role as Pastor`s wife. They labored at the West Vickery Street COGIC,  whichlater moved to 1020 Bryan and the church was renamed \"Love Sanctuary\". They built the edifice on  Bryan St. and they also labored for over 15 years at Grapevine, Texas where they erected the present  Sanctuary.  She is known throughout thecity and state for her many charitable deeds. She is widely known for her  spirit of hospitality, She served as president of the Minister`s Wives of the city and district. Under the  supervision of the late Mother Bertha M. Polk, she worked with all of the auxiliaries and received the  appointment of president of theCity-wide Women`s auxiliary union of Fort Worth and District Missionary  of theDenton district. Other areas served included president of the \"Ever-Ready\" Circle, Co-state president  of hospitality, and Usher Board counselor for the volunteer mission.  Mother Battles became the \"Church Mother\" in 1965 through the recommendation and appointment of her  son Elder E. L. Battles, who took up the mantle from his father`s pastoral work. She remained in that office  until the Lord called her home.  In 1978 at the Sheraton Hotel, Mother Battles was named \"Motherof the Year\" by the F. Brooks and Grays  Literary and Art Club for her distinguished service in the community. Mother Battles was a succourer of  many and herdaily motto \"Lord help me to live from day-to-day in such a self forget forgetful way, that  even when I kneel to pray, my prayer shall be for others.\" She is survived by her beloved son, Dr. E. L.  Battles, her daughter, Mrs. Dorothy R. Lenzy, her foster daughter, Mrs. Mary Stewart, 15 grandchildren, 11  great grandchildren, nieces, nephews, other relatives and a host of friends  Early in her marriage to Gus, Angie worked as a maid for some affluent  white people in Fort Worth. She is credited for getting Gus introduced to  men who helped him finance Battles & Sons Cement Contractors.  Baby was an excellent cook, and she taught herchildren be good cooks also.  Known for her homemade ginger bread, pound cake,and sweet potato pies,  Baby’s specialty was homemade rolls. She passed her recipe down to her  granddaughter, Angela Eileen Lenzy."], "famc": ["@F153@"], "fams": ["@F203@"]}, "@I488@": {"id": "@I488@", "name": "Barbara W.", "given": "Barbara", "surname": "W.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F154@"], "fams": [], "living": true}, "@I197@": {"id": "@I197@", "name": "Elbert Lee Domino/ Sr", "given": "Elbert Lee", "surname": "Domino/ Sr", "sex": "M", "birth": {"date": "May 07 1908", "place": "Overton, Texas"}, "death": {"date": "Mar 02 2000", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F226@"], "fams": ["@F193@"]}, "@I495@": {"id": "@I495@", "name": "James D.", "given": "James", "surname": "D.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F226@"], "fams": [], "living": true}, "@I496@": {"id": "@I496@", "name": "Hattie C.", "given": "Hattie", "surname": "C.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F226@"], "fams": [], "living": true}, "@I6@": {"id": "@I6@", "name": "Cora Walton", "given": "Cora", "surname": "Walton", "sex": "F", "birth": {"date": "Oct 03 1912", "place": "Smith County, Texas"}, "death": {"date": "Jun 28 1990", "place": "Tyler, T