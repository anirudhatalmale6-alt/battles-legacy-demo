main", "surname": "W.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F221@"], "fams": [], "living": true}, "@I287@": {"id": "@I287@", "name": "Darron W.", "given": "Darron", "surname": "W.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F221@"], "fams": [], "living": true}, "@I288@": {"id": "@I288@", "name": "Tasha W.", "given": "Tasha", "surname": "W.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I289@": {"id": "@I289@", "name": "Kendria W.", "given": "Kendria", "surname": "W.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I290@": {"id": "@I290@", "name": "Adrian W.", "given": "Adrian", "surname": "W.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I291@": {"id": "@I291@", "name": "Ashley W.", "given": "Ashley", "surname": "W.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I292@": {"id": "@I292@", "name": "Joshua W.", "given": "Joshua", "surname": "W.", "sex": "M", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I293@": {"id": "@I293@", "name": "Chelsea W.", "given": "Chelsea", "surname": "W.", "sex": "F", "birth": {"date": "", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F222@"], "fams": [], "living": true}, "@I29@": {"id": "@I29@", "name": "Horatio Battles", "given": "Horatio", "surname": "Battles", "sex": "M", "birth": {"date": "Sep 29 1865", "place": "Georgia"}, "death": {"date": "1944", "place": "Smith County, Texas"}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": ["According to the 1900 Census Report, Horatio Battles was born January 1870, butMyrtle Hunt Thomas has his birthday as September 29, 1865. Myrtle remembers Horatio being 79 years old when he died in the summer of 1944. \n\nHoratio married Georgia Ann Jones on \tJanuary 8, 1885 in Smith County. To this union, two children were born: Anthony Battles and Easter Battles. Anthony served in the United States Army and spent most of his time in France. His wife’s name was Bertha.They had no children. Bertha wrote a letter to Settie Hunt in December 1964 fromWatonga, Oklahoma after placing Anthony in a rest home in Geary, Oklahoma. Anthony was living in Oklahoma when he died. Easter died as a young adult.\n\nHoratio married Elizabeth “Lizzie” Carey on \tMarch 1, 1896. Whoever filled out thelicense misspelled Lizzie’s last name as “Carry.”\n\nHoratio and Elizabeth’s Children:\n\n1.\tEdmond Battles; born March 8, 1896, Tyler, Texas; died August 1957, Tyler, Texas. Buried at Oliver Chapel Cemetery.\n2.\tSettie Alma Battles; born September 5, 1898, Tyler, Texas; died December 1991, Fort Worth, Texas. Buried at Skyvue Memorial Gardens, Mansfield, Texas.\n3.\tSam Calvin Battles;born March 12, 1900, Tyler, Texas; died November 27, 1972, Fort Worth, Texas. Buried at Cedar Hill Memorial Park.\n4.\tJohnnie Mae Battles; born January 5, 1903, Tyler, Texas; died March 25, 1974, Tyler, Texas.\n5.\tAugustus “Gus” Battles; born January 28, 1905, Tyler, Texas; died February 22, 1965, Fort Worth, Texas. Buried at Skyvue Memorial Gardens, Rendon, Texas.\n6.\tClemie Battles; born1906; died 1920.\n7.\tLuther “Chap” Battles; born 1908, Tyler, Texas; died October 19, 1930.\n8.\tJames Thomas “J.T.” Battles; born June 25, 1911, Tyler, Texas; died July 30, 1970, Tyler, Texas. Buried at Oliver Chapel Cemetery.\n9.\tL.J. Battles; born March 9, 1915, Tyler, Texas; died February 27, 1984, Fort Worth,Texas. Buried at Cedar Hill Memorial Park.\n10.\tNathaniel Battles, born 1918,Tyler, Texas; died October 1952. Buried at Oliver Chapel Cemetery.\n\nAccording to family members, Horatio and Elizabeth had two additional daughters who each died at very young ages. All of Horatio and Elizabeth’s children were born while Horatio and Elizabeth lived in a log house on Judge Barnes’ Place.\n\nAMason and a deacon with good hair when he was a young man, Horatio was known as“Rashe”. His nickname was often misspelled. On their applications for a SocialSecurity Number, Gus spelled his father’s name “Rash,” L.J. spelled it “Reich,”and Sam spelled it “Rache.” \n\nHoratio farmed, but he also possessed an exceptional talent for working with wood. He could rive boards to provide a lifetime roof for log houses. White people came from near and far to have Horatio buildlog houses. Horatio, his oldest son Edmond, and Horatio’s half-brother, John Johnson, would \ncut, shape, and notch logs with mallets and axes and constructlog houses using a mix of sage grass and white clay. If Horatio built or roofeda log house, his customers knew his work would be high quality and that his roofs and log houses would not leak. \n\nHoratio’s index finger on his right hand was crooked from being broken by riving logs. Horatio also made walking canesand wooden knitting needles. He always kept half of a cow and a hog in a smoke house. He had a special rub that could keep the meat from spoiling for almost a year. \n\nLizzie harvested Irish and sweet potatoes from her garden every year. Shortly after Lizzie died in 1934, a fire destroyed Horatio’s house on JudgeBarnes’ place. Most of the family’s photographs were lost in the fire. Horatio suspected the fire was intentionally set. He had an idea who set it, but no one was ever identified as being responsible. \n\nAfter Elizabeth died in 1934, Horatio married a lady who has been referred to only as Mrs. Holden.\n\nAt the time of his death in 1944, Horatio was living with his sons, Edmond, Nathaniel, and Nathaniel’s wife Carrie in Jack Yancey’s place on Ark Road. Johnnie Battles, who married L.J. Battles in 1945, remembers seeing Horatio in Fort Worth on asingle occasion. Horatio was in a car. Although Horatio and Lizzie are buried at the Oliver Chapel Cemetery, they are not buried next to each other. Their gravesites are not marked."], "famc": ["@F106@"], "fams": ["@F132@", "@F200@"]}, "@I298@": {"id": "@I298@", "name": "Cheris Battles", "given": "Cheris", "surname": "Battles", "sex": "M", "birth": {"date": "1868", "place": ""}, "death": {"date": "1869", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F106@"], "fams": []}, "@I299@": {"id": "@I299@", "name": "William Johnson Daniels", "given": "William Johnson", "surname": "Daniels", "sex": "M", "birth": {"date": "Jan 1864", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F108@"], "fams": ["@F131@"]}, "@I300@": {"id": "@I300@", "name": "Susie Johnson", "given": "Susie", "surname": "Johnson", "sex": "F", "birth": {"date": "May 01 1882", "place": "Smith County, Texas"}, "death": {"date": "May 15 1974", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": ["In Memory of Susie Johnson Choice  Mrs. Susie Choice. the daughter of the late Mr. and Mrs. William Johnson, was born May 1,  1882 in Smith County, Texas.  Manyyears ago she united with the New Zion Baptist Church # 2, and was an active member  until her health failed.  She was a charter member of Queen of Honor Court#185 and served as Joshua for several  years.  She was united in marriage to Mr. Wallace Choice, who preceded her in death. To this union  seven children wereborn, she had one son by a former marriage, Willie Starr, Jr. Two sons and  onedaughter preceded her in death.  Mrs. Choice departed this life May 10, 1974 at6:30 am. Her survivors include five daughters,  Miss Eulalia Choice, Mrs. Lois Murphy, Mrs. Laura C. Francis, Miss Jessie Choice, Mrs. Annie  B. Langley stepdaughter all of Tyler, Texas, Mrs. Mattie D. Bolton of Venus, Texas, five  nieces,one nephew, twenty-two grandchildren, forty-one great grandchildren and a host of  other relatives and friends.  Services Wednesday, May 15, 1974, 2:00 p.m., New Zion Baptist Church, Tyler, Texas. Brooks-Sterling  Funeral Directors."], "famc": ["@F109@"], "fams": ["@F128@", "@F129@"]}, "@I301@": {"id": "@I301@", "name": "John Henry Johnson", "given": "John Henry", "surname": "Johnson", "sex": "M", "birth": {"date": "ABT  1874", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F109@"], "fams": ["@F130@"]}, "@I302@": {"id": "@I302@", "name": "Anna Johnson", "given": "Anna", "surname": "Johnson", "sex": "F", "birth": {"date": "1869", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F109@"], "fams": []}, "@I409@": {"id": "@I409@", "name": "Asiana Johnson", "given": "Asiana", "surname": "Johnson", "sex": "F", "birth": {"date": "ABT  1868", "place": ""}, "death": {"date": "", "place": ""}, "burial": {"date": "", "place": ""}, "occupation": [], "education": [], "notes": [], "famc": ["@F109@"], "fams": [